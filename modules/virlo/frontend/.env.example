# Frontend (Vite)
VITE_GOOGLE_CLIENT_ID=
VITE_API_BASE_URL=/api/v1
# Set when building for CrazyTrail: /virlo/
VITE_BASE_PATH=/

# Future FastAPI / CrazyTrail server (do not expose to Vite client)
# These match CrazyTrail serverless naming — configure in Vercel / local .env only
MONGODB_URI=
MONGODB_DB=crazytrail
MONGODB_COLLECTION=virlo_users
JWT_SECRET=
GOOGLE_CLIENT_ID=
