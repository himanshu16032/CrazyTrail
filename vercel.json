{
  "rewrites": [
    { "source": "/d/:id", "destination": "/api/d/:id" },
    {
      "source": "/((?!api/.*|d/.*|favicon\\.svg|apple-touch-icon\\.svg|images/.*|sitemap\\.xml|robots\\.txt).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/d/[id].js": {
      "includeFiles": "api/d/_*.{html,css}"
    }
  }
}
