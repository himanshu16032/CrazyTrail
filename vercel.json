{
  "redirects": [
    { "source": "/newsroom", "destination": "/blog", "permanent": true },
    { "source": "/newsroom/:path*", "destination": "/blog", "permanent": true },
    { "source": "/marketplace", "destination": "/topics", "permanent": true },
    { "source": "/marketplace/:path*", "destination": "/topics", "permanent": true },
    { "source": "/register", "destination": "/?ref=register", "permanent": true },
    { "source": "/register/:path*", "destination": "/?ref=register", "permanent": true },
    { "source": "/help", "destination": "/#faq", "permanent": true },
    { "source": "/help/:path*", "destination": "/#faq", "permanent": true }
  ],
  "rewrites": [
    { "source": "/d/:id", "destination": "/api/d/:id" },
    {
      "source": "/((?!api/.*|d/.*|favicon\\.svg|apple-touch-icon\\.svg|og-image\\.jpg|images/.*|sitemap.*\\.xml|robots\\.txt|llms\\.txt|ai\\.txt|feed\\.xml|google.*\\.html).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(llms\\.txt|ai\\.txt)",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/feed.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/rss+xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=1800" }
      ]
    }
  ],
  "functions": {
    "api/d/[id].js": {
      "includeFiles": "api/d/_*.{html,css}"
    }
  }
}
